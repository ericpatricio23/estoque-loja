# Copie para .env e troque TODOS os valores marcados.
# O arquivo .env nunca vai para o Git.

# Banco de dados
POSTGRES_DB=deadline
POSTGRES_USER=postgres
POSTGRES_PASSWORD=troque-por-uma-senha-forte

# Chave que assina os tokens de login (gere com: openssl rand -base64 48)
JWT_SECRET=troque-por-uma-chave-gerada

# Senha do usuário admin. Só vale na primeira subida: o admin é criado uma vez
# e esta variável não troca a senha de um admin que já existe.
ADMIN_PASSWORD=troque-por-uma-senha-forte

# Imagens (publicadas pelo CI) e porta em que o sistema atende na rede da loja
API_IMAGE=ghcr.io/ericpatricio23/estoque-api:latest
WEB_IMAGE=ghcr.io/ericpatricio23/estoque-web:latest
WEB_PORT=80
